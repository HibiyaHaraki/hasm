{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hasm",
  "version": "0.1.0",
  "identifier": "com.hibiy.hasm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hasm",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "HASM - Starting",
        "url": "splash/sprash_animation.html?background=theme",
        "width": 900,
        "height": 540,
        "center": true,
        "decorations": false,
        "resizable": false,
        "backgroundColor": "#f8fafc"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/hasm_favicon.png",
      "icons/hasm_logo_transparent.png",
      "icons/hasm_logo_light_bg.png",
      "icons/hasm_logo_dark_bg.png"
    ]
  }
}
