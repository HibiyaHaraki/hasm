{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hasm",
  "version": "0.1.0",
  "identifier": "com.hibiy.hasm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hasm",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../hasm_logo/logo/hasm/hasm_favicon.png",
      "../hasm_logo/logo/hasm/hasm_logo_transparent.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
