name: CI

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

permissions:
  contents: read

jobs:
  frontend:
    name: Frontend Build
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          submodules: recursive
          lfs: true

      - name: Sync submodules
        run: git submodule sync --recursive

      - name: Update submodules
        run: git submodule update --init --recursive

      - name: Pull Git LFS objects for repository and submodules
        shell: pwsh
        run: |
          git lfs install --local
          git lfs pull
          git submodule foreach --recursive 'git lfs install --local; git lfs pull'

      - name: Setup Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        run: npm install

      - name: EVAL-01 React and IPC tests
        run: npm run test:eval-01

      - name: EVAL-02 React and IPC tests
        run: npm run test:eval-02

      - name: EVAL-03 React and IPC tests
        run: npm run test:eval-03

      - name: EVAL-04 React and IPC tests
        run: npm run test:eval-04

      - name: EVAL-05 React and IPC tests
        run: npm run test:eval-05

      - name: EVAL-07 React tests
        run: npm run test:eval-07

      - name: EVAL-08 React and IPC tests
        run: npm run test:eval-08

      - name: Build frontend
        run: npm run build

  rust:
    name: Rust Check (Windows)
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          submodules: recursive
          lfs: true

      - name: Sync submodules
        run: git submodule sync --recursive

      - name: Update submodules
        run: git submodule update --init --recursive

      - name: Pull Git LFS objects for repository and submodules
        shell: pwsh
        run: |
          git lfs install --local
          git lfs pull
          git submodule foreach --recursive 'git lfs install --local; git lfs pull'

      - name: Setup Rust toolchain
