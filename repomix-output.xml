        log_step(test_name, "Step 5", "Read extracted main.md and compare markdown text");
        let extracted_text = fs::read_to_string(&extracted_main_md).unwrap_or_else(|e| {
            panic!(
                "[ERROR] {} | Step 5 failed: cannot read {}: {}",
